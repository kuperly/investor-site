RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Canonical site origin for SEO metadata (optional; defaults to https://valeforgecapital.com)
NEXT_PUBLIC_SITE_URL=

# Optional: the internal Deal Analyzer is served at /apps on this site (path fixed in
# next.config.ts). By default it proxies to the Railway deployment; set ANALYZER_URL to
# another origin (no trailing slash) to point elsewhere, or to "off" to disable the route.
ANALYZER_URL=
