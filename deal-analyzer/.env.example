# Optional. PostgreSQL / Supabase connection string (Settings → Database → Connection string, "Transaction" pooler).
# When unset, an embedded PGlite database is stored in ./.data/pglite.
DATABASE_URL=

# Optional. When both are set, every request requires HTTP Basic Auth (recommended for any deployed instance).
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# Optional. Serve the app under a sub-path (e.g. /vf-internal) so the investor website
# can expose it as a hidden route. Build-time setting — must match the website's value.
ANALYZER_BASE_PATH=
