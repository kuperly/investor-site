# Names only. Real values are set on the hosting service (Railway → deal-analyzer → Variables),
# never committed. Full list and meaning: README.md → "Deploying" and "Users and sign-in".

# Optional. PostgreSQL connection string. When unset, an embedded PGlite database is stored in
# ./.data/pglite (or PGLITE_DIR).
DATABASE_URL=
# PGLITE_DIR=

# Sign-in. SESSION_SECRET (32+ characters) is required in production: without it every request
# answers 503 (fail-closed). ADMIN_USERNAME / ADMIN_PASSWORD (12+ characters) create the first
# admin on the first sign-in while there are no users; ADMIN_DISPLAY_NAME is optional.
SESSION_SECRET=
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=
# AUTH_DISABLED=1 is open-access mode (no login; changes recorded as "Open access (login off)").
# On a deployment only by the owner's explicit decision: anyone with the URL can read and edit.
# AUTH_DISABLED=

# Optional. Serve the app under a sub-path so the website can expose it at /apps.
# Build-time setting; must equal the website's ANALYZER_BASE_PATH constant (/apps).
ANALYZER_BASE_PATH=

# Market Intelligence data sources (free keys). A source shows "Not configured" until its key is set.
CENSUS_API_KEY=
HUD_API_TOKEN=
FRED_API_KEY=
BLS_API_KEY=
# ACS_YEAR=   (optional override of the Census ACS 5-year release)
