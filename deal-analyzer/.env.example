# Optional. PostgreSQL / Supabase connection string (Settings → Database → Connection string, "Transaction" pooler).
# When unset, an embedded PGlite database is stored in ./.data/pglite.
DATABASE_URL=

# Required in production. When both are set, every request requires HTTP Basic Auth.
# Fail-closed: a production server with these unset answers 503 to everything.
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
# Local production runs only (npm run e2e sets it): AUTH_DISABLED=1 allows no password. Never set it on a deployment.

# Optional. Serve the app under a sub-path (e.g. /vf-internal) so the investor website
# can expose it as a hidden route. Build-time setting — must match the website's value.
ANALYZER_BASE_PATH=
